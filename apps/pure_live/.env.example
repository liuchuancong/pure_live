# Copy to .env (not committed) and adjust. Values are baked in by
# `dart run build_runner build`, so re-run it after editing.

# Where a diagnostic run roots its data instead of the OS application-support
# directory. The `.run-data/` name is what .gitignore already excludes.
# PURE_LIVE_DATA_DIR=.run-data

# Route every site request through one proxy, overriding the process
# HTTP_PROXY/HTTPS_PROXY that live_net's system route would use.
# PURE_LIVE_PROXY=http://127.0.0.1:7897

# TV build: focus-only navigation, no bottom bar or rail.
PURE_LIVE_TV=false
