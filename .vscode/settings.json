{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "cmake.sourceDirectory": "D:/flutter/pure_live/linux",
    "[dart]": {
        "editor.defaultFormatter": "Dart-Code.dart-code",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit"
        }
    },

    "dart.lineLength": 100,
    "dart.previewFlutterUiGuides": true,
    "yaml.validate": true,
    "yaml.schemas": {
        "https://json.schemastore.org/github-action.json": [".github/actions/*/action.yml", ".github/actions/*/action.yaml"],
        "https://json.schemastore.org/github-workflow.json": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    }
}
